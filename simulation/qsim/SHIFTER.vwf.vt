`timescale 1 ps/ 1 ps
module SHIFTER_vlg_sample_tst(
	INPUT,
	MIR,
	sampler_tx
);
input [31:0] INPUT;
input [23:22] MIR;
output sampler_tx;

reg sample;
time current_time;
always @(INPUT or MIR)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

