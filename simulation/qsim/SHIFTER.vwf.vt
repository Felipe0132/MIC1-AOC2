end 
endmodule

module SHIFTER_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [31:0] INPUT;
reg [23:22] MIR;
// wires                                               
wire N;
wire [31:0] OUTPUT;
wire Z;

wire sampler;                             

// assign statements (if any)                          
SHIFTER i1 (
// port map - connection between master ports and signals/registers   
	.\INPUT (INPUT),
	.MIR(MIR),
	.N(N),
	.\OUTPUT (OUTPUT),
	.Z(Z)
);

// MIR[23]
always
begin
	MIR[23] = 1'b0;
	MIR[23] = #500000 1'b1;
	#500000;
end 

// MIR[22]
always
begin
	MIR[22] = 1'b0;
	MIR[22] = #250000 1'b1;
	#250000;
end 
// \INPUT [ 31 ]
initial
begin
	INPUT[31] = 1'b1;
	INPUT[31] = #750000 1'b0;
end 
